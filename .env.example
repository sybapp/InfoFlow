# Security Configuration
# IMPORTANT: Change these values in production!

# Password encryption seed - used for backward compatibility with MD5 passwords
PASSWORD_ENCRYPT_SEED=(infoflow)@#$

# Phone number encryption key (AES-256, must be 32 bytes)
PHONE_AES_KEY=5A2E746B08D846502F37A6E2D85D583B

# Database Configuration
# MYSQL_DSN=user:password@tcp(localhost:3306)/database?charset=utf8mb4&parseTime=True&loc=Local

# Redis Configuration
# REDIS_HOST=localhost:6379
# REDIS_PASS=

# Kafka Configuration
# KAFKA_BROKERS=localhost:9092

# OSS Configuration
# OSS_ENDPOINT=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=

# JWT Configuration
# JWT_ACCESS_SECRET=your-secret-key-here
# JWT_ACCESS_EXPIRE=86400
